<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Spec §2: App Sandbox with the camera entitlement ONLY.

  com.apple.security.network.client and com.apple.security.network.server
  MUST NEVER be added to this file. The absence of network entitlements is
  the app's verifiable privacy claim (`codesign -d - -entitlements` on the
  shipped binary) and is enforced by a CI check that fails the build if
  either key appears here. If a feature seems to require network access,
  stop and escalate to the maintainer — it is out of scope by design.
-->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<!--
	  Powers the debug panel's Export/Import (spec §9): NSSavePanel/NSOpenPanel
	  need this entitlement to actually read/write the file the user picks,
	  even though the panel itself is always shown. This is the standard
	  "user-selected file" sandbox exception, not a network entitlement — it
	  does not weaken the §2 no-network privacy claim the CI guard checks.
	-->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
